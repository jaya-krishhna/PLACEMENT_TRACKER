# PostgreSQL Connection URL
# Replace user, password, host, port, and database name with your local PostgreSQL setup
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/placement_tracker

# Ports
PORT=8080
API_TARGET=http://localhost:8080
BASE_PATH=/
NODE_ENV=development

# Gmail Integration (Phase 1)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/api/gmail/callback
TOKEN_ENCRYPTION_KEY=32_byte_base64_encoded_key_here
APP_BASE_URL=http://localhost:3000

# AI Extraction (Phase 2)
AI_PRIMARY_MODEL=gemini-3.5-flash-lite
AI_PRIMARY_API_KEY=
AI_FALLBACK_MODEL=gemini-3.8-flash
AI_FALLBACK_API_KEY=
AI_PROVIDER=gemini
AI_MAX_BODY_CHARS=6000
DEFAULT_TIMEZONE=Asia/Kolkata
